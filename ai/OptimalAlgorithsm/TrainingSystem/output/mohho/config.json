  "feature_selection_threshold": 0.5,
  "objectives": [
    "1 - recall",
    "1 - precision",
    "num_feature / 8"
  ],
  "config": {
    "population_size": 50,
    "generations": 100,
    "dimensions": 9,
    "archive_size": 100,
    "levy_beta": 1.5,
    "levy_scale": 0.01,
    "seed": 42
  }
